# Database (PostgreSQL)
DATABASE_URL="postgresql://warungai:warungai_secret@localhost:5432/warungai_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Object Storage (MinIO / S3 / R2)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_BUCKET="warungai-media"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"

# Authentication
AUTH_SECRET="warungai_dev_secret_key_minimum_32_characters"

# Internal services
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_INTERNAL_TOKEN="internal_dev_token"

# Applications
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
