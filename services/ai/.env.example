# WarungAI AI Service — environment template
# Copy to .env.local and fill in real values

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
DEBUG=false

# Storage (MinIO local / Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=warungai-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=

# AI Provider API Keys (leave empty in mock/dev mode)
OPENAI_API_KEY=
REPLICATE_API_KEY=
STABILITY_API_KEY=
FAL_API_KEY=

# Shared internal secret — must match API_INTERNAL_SECRET in apps/api .env
INTERNAL_API_SECRET=warungai-internal-secret
